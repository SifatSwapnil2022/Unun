# Port the API listens on.
PORT=4000

# Leave empty to use the embedded PostgreSQL (PGlite), stored in apps/api/.data.
# Set it to use a real PostgreSQL server, for example:
# DATABASE_URL=postgres://unun:unun@localhost:5432/unun
DATABASE_URL=

# The web app's address, allowed to call the API from a browser.
WEB_ORIGIN=http://localhost:3000

# How much faster than real time the demo simulator moves an order along.
# 30 means a 40-minute delivery plays out in 80 seconds. 1 is real time.
DEMO_SPEED=30

# 1 lets visitors order at any hour. 0 enforces each kitchen's opening hours.
DEMO_ALWAYS_OPEN=1

# Demo sign-in. 1 shows the one-time code on the page instead of sending an SMS, and
# seeds accounts for an owner, riders and an admin that any visitor may use, plus four
# weeks of past orders with their ratings. Set it to 0 before real people sign in; codes
# are then printed where the API runs until an SMS gateway is connected.
DEMO_LOGIN=1

# A mobile number that is made an admin every time the API starts. Use it to create the
# first admin when DEMO_LOGIN is 0.
# ADMIN_PHONE=01712345678

# The test gateway for bKash and card payments. 1 sends them to a page of this site,
# where a payment is approved or declined by pressing a button and no money moves.
PAYMENT_SANDBOX=1

# bKash merchant settings. With all four set, bKash payments go to bKash's tokenized
# checkout instead of the test gateway. Leave them out to stay on the test gateway.
# BKASH_USERNAME=
# BKASH_PASSWORD=
# BKASH_APP_KEY=
# BKASH_APP_SECRET=
# bKash's test servers are the default. A live merchant account has its own address.
# BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta

# The address a payment gateway sends the customer back to. It must be reachable from
# the customer's browser, so set it wherever the API is not on localhost.
# API_PUBLIC_URL=https://api.example.com

# The learning service in services/ml: arrival times, search and suggestions. The API
# works without it. "off" stops the API from looking for it.
ML_URL=http://127.0.0.1:8000

# What the learning service must send to read menus and finished orders from the API.
# On a developer's machine a fixed key is used when this is empty. On a server, set a
# long random value here and give the same value to the service.
# INTERNAL_KEY=
